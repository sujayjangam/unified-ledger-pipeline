# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# --- Database ---
# Neon Postgres connection string. Use the DIRECT (unpooled) endpoint: SQLAlchemy runs its own
# connection pool, so Neon's PgBouncer-fronted endpoint would just stack a second pooler
# underneath it. Note the "+psycopg" driver suffix - plain "postgresql://" defaults to psycopg2,
# which is not installed.
DATABASE_URL=postgresql+psycopg://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456789:AAaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Who may use the bot, and their cards, are rows in the participants and accounts tables, not
# settings here (#53) - see scripts/seed_directory.py and directory_seed.example.json.

# --- OpenAI (Whisper transcription + GPT extraction) ---
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Deployment ---
# Optional: only used by bot_webhook.py to register the Telegram webhook on startup.
# Leave unset for local development (bot_local.py doesn't need it).
WEBHOOK_URL=https://your-service-xxxxx.a.run.app

# Required whenever WEBHOOK_URL is set - bot_webhook.py refuses to start without it. Registered
# with Telegram at startup; Telegram then sends it in a header on every webhook delivery, and
# /webhook rejects any request that doesn't carry it. Telegram's format: 1-256 characters of
# A-Z a-z 0-9 _ -. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production this comes from Secret Manager, like the other secrets.
WEBHOOK_SECRET_TOKEN=generate-a-long-random-value-see-above
