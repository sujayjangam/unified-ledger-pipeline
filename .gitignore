# Python environment
ledger-env/
.venv/
venv/
__pycache__/
*.pyc

# Local Data (Crucial for privacy!)
data/ledger.db
*.db
# Pre-Postgres-migration SQLite snapshot, kept locally as a rollback safety net
data/ledger.db.pre-migration-backup
# Local test statement files (PDF/CSV) for parser work - kept out of this public repo
Test PDF_CSV/

# API key for telegram and other env variables
.env
# ...and every variant of it (.env.local holds the local-testing bot token). The ".env"
# rule above does NOT cover these - git reads it as a literal filename, not a prefix.
.env.*
!.env.example

# Private job-search/portfolio notes, not part of the public project docs
claude-jobhunt-context.md
claude-jobhunt-*
# Working plans for in-flight changes. Kept local because drafts name real household
# members and real card names - ROADMAP.md/the issue tracker are the public record.
claude-plan-*.md
.claude/agents/doc-checker.md
*Resume*.docx
*Resume*.pdf

# OS files
.DS_Store
